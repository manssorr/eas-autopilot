{
  "flow": 1,
  "id": "eas-ios-credentials",
  "description": "eas credentials for iOS: pick the profile, log in to Apple, set up all build credentials (reuse the distribution certificate, regenerate provisioning profiles), then leave. Needs EXPO_TOKEN in the caller's environment: the eas zsh wrapper is bypassed by npx, so export the routed Expo token before running.",
  "command": [
    "npx",
    "eas-cli",
    "credentials",
    "-p",
    "ios"
  ],
  "params": {
    "profile": {
      "default": "preview"
    },
    "udid": {
      "optional": true
    }
  },
  "secrets": [
    "[Pp]assword",
    "two-factor|2FA|[Cc]ode\\b"
  ],
  "hints": [
    {
      "match": "Waking up",
      "text": "npx is starting eas-cli and evaluating the app config. If it stalls on a login, EXPO_TOKEN is missing: the caller must set it (the eas zsh wrapper is bypassed by npx)"
    },
    {
      "match": "Fetching Apple",
      "text": "Apple's developer API is often slow"
    },
    {
      "match": "Credentials for",
      "text": "every app target and extension needs its own provisioning profile"
    }
  ],
  "rules": [
    {
      "id": "target",
      "on": {
        "output": "Setting up credentials for target (\\S+)"
      },
      "capture": {
        "target": "target (\\S+)"
      },
      "phase": "🎯 Credentials for {target}"
    },
    {
      "id": "build-profile",
      "on": {
        "prompt": "^Which build profile do you want to configure\\?"
      },
      "do": {
        "menu": "^{profile}$"
      },
      "show": "📦 Profile {profile}"
    },
    {
      "id": "apple-login",
      "on": {
        "prompt": "^Do you want to log in to your Apple account\\?"
      },
      "do": {
        "answer": ""
      },
      "show": "🍏 Apple login: yes"
    },
    {
      "id": "apple-id",
      "on": {
        "prompt": "^Apple ID:"
      },
      "do": {
        "answer": ""
      },
      "show": "🍏 Apple ID: default"
    },
    {
      "id": "apple-secret",
      "on": {
        "prompt": "[Pp]assword|two-factor|2FA|[Cc]ode\\b"
      },
      "do": {
        "ask": "Apple credential needed"
      }
    },
    {
      "id": "credentials-menu",
      "on": {
        "prompt": "^What do you want to do\\?"
      },
      "do": {
        "menu": [
          "^Build Credentials",
          "^All: Set up all",
          "^Go back$",
          "^Exit$"
        ]
      }
    },
    {
      "id": "reuse-distribution-certificate",
      "on": {
        "prompt": "^Reuse this distribution certificate\\?"
      },
      "do": {
        "answer": ""
      },
      "show": "♻️  Reusing the distribution certificate"
    },
    {
      "id": "generate-profile",
      "on": {
        "prompt": "^Generate a new Apple Provisioning Profile\\?"
      },
      "do": {
        "answer": ""
      },
      "show": "📝 Generating the provisioning profile"
    },
    {
      "id": "no-registered-devices",
      "on": {
        "prompt": "^You don't have any registered devices yet"
      },
      "do": {
        "exit": {
          "code": 6,
          "result": "no-registered-devices",
          "message": "No devices are registered for this Apple team. Register them with npx eas-cli device:create, then run again."
        }
      }
    },
    {
      "id": "choose-devices-again",
      "on": {
        "prompt": "^Would you like to choose the devices to provision again\\?"
      },
      "do": {
        "answer": "y"
      },
      "show": "🔍 Profile is missing devices, choosing again"
    },
    {
      "id": "select-devices",
      "on": {
        "prompt": "^Select devices for the ad hoc build"
      },
      "do": {
        "select-all": {
          "toggle": "a",
          "checked": "◉",
          "unchecked": "◯",
          "after": "Space to select",
          "tries": 4
        }
      },
      "capture_after": {
        "selected": "(\\d+) devices? selected"
      },
      "collect": {
        "devices": "{target}: {selected}"
      },
      "show": "📱 Selected all {selected} registered devices"
    },
    {
      "id": "refused-devices",
      "on": {
        "output": "Failed to provision \\d+ of the selected devices:[\\s\\S]*?Most commonly"
      },
      "capture": {
        "failed": {
          "each": "^\\s*- (.+)$"
        }
      }
    },
    {
      "id": "refused-target-device",
      "on": {
        "prompt": "^Do you want to continue without provisioning these devices\\?"
      },
      "when": {
        "var": "failed",
        "contains": "{udid}"
      },
      "do": {
        "choose": {
          "tone": "bad",
          "icon": "🍎",
          "title": "Your device is not in this build",
          "body": [
            "Apple did not provision \u001b[1m{udid}\u001b[0m yet.",
            "",
            "{failed}",
            "",
            "\u001b[2mA new device can stay in Processing at Apple for up to 72 h.\u001b[0m",
            "\u001b[2mYour answer applies to every target in this run.\u001b[0m",
            "\u001b[2mBuilding now leaves it out and still uses a build credit.\u001b[0m"
          ],
          "options": [
            {
              "key": "n",
              "label": "Stop, no build (recommended)",
              "then": {
                "exit": {
                  "code": 3,
                  "result": "device-not-provisioned-at-apple",
                  "message": "Stopped before building: Apple has not accepted {udid} yet. Run again once it shows Enabled at https://developer.apple.com/account/resources/devices/list"
                }
              }
            },
            {
              "key": "y",
              "label": "Build without it",
              "then": {
                "answer": ""
              },
              "show": "🍎 Building without {udid}"
            }
          ],
          "per_run": true
        }
      }
    },
    {
      "id": "refused-other-devices",
      "on": {
        "prompt": "^Do you want to continue without provisioning these devices\\?"
      },
      "when": {
        "var": "failed"
      },
      "do": {
        "answer": ""
      },
      "show": "🍎 Continuing without {failed.length} device(s) Apple has not accepted yet"
    },
    {
      "id": "reuse-profile",
      "on": {
        "prompt": "reuse the (original )?profile\\?"
      },
      "do": {
        "answer": "y"
      },
      "show": "♻️  Profile already has every device, reusing it"
    },
    {
      "id": "press-any-key",
      "on": {
        "output": "Press any key to continue"
      },
      "do": {
        "answer": ""
      }
    }
  ]
}